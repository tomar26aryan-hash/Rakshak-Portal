# ============================================================
# Rakshak Portal - configuration
# Copy this file to ".env" for local use, or enter these values
# in your hosting provider's "Environment Variables" screen.
# NEVER commit the real .env file.
# ============================================================

# --- Server -------------------------------------------------
NODE_ENV=production
PORT=5000

# Behind a reverse proxy / PaaS (Render, Railway, Nginx, Caddy, Cloudflare)? Use 1.
# Exposed directly to the internet with NO proxy in front? Use false
# (otherwise attackers can fake their IP and dodge the rate limiter).
# Default: 1 in production, false otherwise.
TRUST_PROXY=1

# Redirect http -> https (turn on once your site has HTTPS).
FORCE_HTTPS=false

# Only needed if the frontend is hosted on a DIFFERENT domain than this server.
# Comma-separated list, e.g. https://portal.example.com
CORS_ORIGIN=

# --- Security -----------------------------------------------
# REQUIRED in production. At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12

# --- Database (option A: individual settings) ---------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=rakshak
DB_PASSWORD=
DB_NAME=rakshak_portal

# --- Database (option B: single URL, overrides option A) ----
# DATABASE_URL=mysql://user:password@host:3306/rakshak_portal

# Managed databases (Aiven, TiDB Cloud, ...) usually require TLS:
DB_SSL=false
# DB_SSL_REJECT_UNAUTHORIZED=true

# Create tables automatically on start-up (safe to leave on; it only creates what is missing).
DB_AUTO_INIT=true

# --- First administrator ------------------------------------
# If these three are set and no admin exists yet, one is created on start-up.
# Remove ADMIN_PASSWORD from the environment after the first successful start.
ADMIN_USERNAME=youradmin
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=a-strong-password
ADMIN_FULL_NAME=Portal Administrator
ADMIN_MOBILE=your-number

# --- Docker Compose only ------------------------------------
# DB_ROOT_PASSWORD=
